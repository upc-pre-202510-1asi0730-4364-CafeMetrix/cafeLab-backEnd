{
  /**
   * Configuración principal de la aplicación CafeLab - Sistema de Defectos y Calibraciones
   * 
   * Este archivo contiene todas las configuraciones necesarias para el funcionamiento
   * de la aplicación, incluyendo:
   * - Configuración de logging
   * - Configuración de conexión a base de datos
   * - Configuración de autenticación JWT
   * - Configuración de CORS
   * - Configuración de Swagger
   * - Configuración de seguridad
   * 
   * IMPORTANTE: En producción, las claves secretas deben estar en variables de entorno
   * o en un sistema de gestión de secretos seguro.
   */
  
  /**
   * Configuración de logging
   * 
   * Define cómo se registran los eventos y errores de la aplicación:
   * - LogLevel: Nivel de detalle de los logs
   * - Console: Configuración para logs en consola
   * - Debug: Configuración para logs de depuración
   * - EventSource: Configuración para eventos del sistema
   * - EventLog: Configuración para logs del sistema Windows
   */
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Debug": {
      "LogLevel": {
        "Default": "Information"
      }
    },
    "EventSource": {
      "LogLevel": {
        "Default": "Warning"
      }
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },

  /**
   * Configuración de conexiones a base de datos
   * 
   * Define las cadenas de conexión para diferentes bases de datos:
   * - DefaultConnection: Conexión principal a MySQL local
   * - ConnectionStrings: Configuraciones adicionales si es necesario
   * 
   * NOTA: En producción, las cadenas de conexión deben estar en variables de entorno
   * o en un sistema de gestión de secretos.
   */
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=cafelab_db;User=root;Password=;"
  },

  /**
   * Configuración de autenticación JWT
   * 
   * Define los parámetros para la generación y validación de tokens JWT:
   * - SecretKey: Clave secreta para firmar tokens (DEBE SER SEGURA EN PRODUCCIÓN)
   * - Issuer: Emisor del token (normalmente el dominio de la aplicación)
   * - Audience: Audiencia del token (normalmente el dominio del cliente)
   * - AccessTokenExpirationMinutes: Tiempo de expiración del token de acceso
   * - RefreshTokenExpirationDays: Tiempo de expiración del refresh token
   * 
   * SEGURIDAD: La SecretKey debe tener al menos 32 caracteres y ser completamente aleatoria.
   * En producción, debe estar en variables de entorno o Azure Key Vault.
   */
  "JwtSettings": {
    "SecretKey": "CafeLab_Super_Secure_Secret_Key_For_JWT_Tokens_2024_Minimum_32_Characters_Long",
    "Issuer": "CafeLab.API",
    "Audience": "CafeLab.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },

  /**
   * Configuración de CORS (Cross-Origin Resource Sharing)
   * 
   * Define qué orígenes pueden acceder a la API:
   * - AllowedOrigins: Lista de dominios permitidos
   * - AllowedMethods: Métodos HTTP permitidos
   * - AllowedHeaders: Headers HTTP permitidos
   * - AllowCredentials: Si se permiten credenciales (cookies, auth headers)
   * 
   * IMPORTANTE: En producción, especificar exactamente los dominios permitidos.
   * No usar "*" para AllowCredentials: true.
   */
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://localhost:3000",
      "https://localhost:5173"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "X-Requested-With"
    ],
    "AllowCredentials": true
  },

  /**
   * Configuración de Swagger/OpenAPI
   * 
   * Define la configuración para la documentación automática de la API:
   * - Title: Título de la documentación
   * - Version: Versión de la API
   * - Description: Descripción de la API
   * - Contact: Información de contacto del equipo de desarrollo
   * - License: Información de licencia
   */
  "SwaggerSettings": {
    "Title": "CafeLab API - Sistema de Defectos y Calibraciones",
    "Version": "v1",
    "Description": "API REST para el sistema de gestión de defectos y calibraciones de CafeLab",
    "Contact": {
      "Name": "CafeLab Development Team",
      "Email": "dev@cafelab.com",
      "Url": "https://cafelab.com"
    },
    "License": {
      "Name": "MIT",
      "Url": "https://opensource.org/licenses/MIT"
    }
  },

  /**
   * Configuración de seguridad
   * 
   * Define configuraciones adicionales de seguridad:
   * - RequireHttps: Si se requiere HTTPS en producción
   * - HstsMaxAge: Tiempo máximo para HSTS (HTTP Strict Transport Security)
   * - RateLimiting: Configuración de límites de peticiones
   * - PasswordPolicy: Política de contraseñas
   */
  "SecuritySettings": {
    "RequireHttps": true,
    "HstsMaxAge": 365,
    "RateLimiting": {
      "PermitLimit": 100,
      "WindowMinutes": 1,
      "QueueLimit": 2
    },
    "PasswordPolicy": {
      "MinimumLength": 8,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireSpecialCharacter": true
    }
  },

  /**
   * Configuración de la aplicación
   * 
   * Define configuraciones generales de la aplicación:
   * - Name: Nombre de la aplicación
   * - Version: Versión de la aplicación
   * - Environment: Entorno de ejecución
   * - DefaultLanguage: Idioma por defecto
   * - SupportedLanguages: Idiomas soportados
   */
  "ApplicationSettings": {
    "Name": "CafeLab - Sistema de Defectos y Calibraciones",
    "Version": "1.0.0",
    "Environment": "Development",
    "DefaultLanguage": "es",
    "SupportedLanguages": ["es", "en"],
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },

  /**
   * Configuración de auditoría
   * 
   * Define configuraciones para el sistema de auditoría:
   * - EnableAuditLogging: Si se habilita el logging de auditoría
   * - AuditTableName: Nombre de la tabla de auditoría
   * - RetentionDays: Días de retención de logs de auditoría
   */
  "AuditSettings": {
    "EnableAuditLogging": true,
    "AuditTableName": "AuditLogs",
    "RetentionDays": 365,
    "LogUserActions": true,
    "LogSystemEvents": true
  },

  /**
   * Configuración de caché
   * 
   * Define configuraciones para el sistema de caché:
   * - EnableCaching: Si se habilita el caché
   * - DefaultExpirationMinutes: Tiempo de expiración por defecto
   * - MaxCacheSize: Tamaño máximo del caché en MB
   */
  "CacheSettings": {
    "EnableCaching": true,
    "DefaultExpirationMinutes": 30,
    "MaxCacheSize": 100
  },

  /**
   * Configuración de notificaciones
   * 
   * Define configuraciones para el sistema de notificaciones:
   * - EmailSettings: Configuración de email
   * - SmsSettings: Configuración de SMS
   * - PushSettings: Configuración de notificaciones push
   */
  "NotificationSettings": {
    "EmailSettings": {
      "SmtpServer": "smtp.gmail.com",
      "SmtpPort": 587,
      "EnableSsl": true,
      "FromEmail": "noreply@cafelab.com",
      "FromName": "CafeLab System"
    },
    "SmsSettings": {
      "Provider": "Twilio",
      "AccountSid": "",
      "AuthToken": ""
    },
    "PushSettings": {
      "EnablePushNotifications": false,
      "VapidPublicKey": "",
      "VapidPrivateKey": ""
    }
  },

  /**
   * Configuración de monitoreo
   * 
   * Define configuraciones para el monitoreo de la aplicación:
   * - EnableHealthChecks: Si se habilitan las verificaciones de salud
   * - MetricsEnabled: Si se habilitan las métricas
   * - LoggingLevel: Nivel de logging para monitoreo
   */
  "MonitoringSettings": {
    "EnableHealthChecks": true,
    "MetricsEnabled": true,
    "LoggingLevel": "Information",
    "PerformanceCounters": {
      "EnableCpuMonitoring": true,
      "EnableMemoryMonitoring": true,
      "EnableDiskMonitoring": true
    }
  },

  /**
   * Configuración de desarrollo
   * 
   * Configuraciones específicas para el entorno de desarrollo:
   * - EnableDetailedErrors: Si se muestran errores detallados
   * - EnableSwagger: Si se habilita Swagger
   * - SeedData: Si se cargan datos de prueba
   */
  "DevelopmentSettings": {
    "EnableDetailedErrors": true,
    "EnableSwagger": true,
    "SeedData": true,
    "MockExternalServices": true
  },

  /**
   * Configuración de producción
   * 
   * Configuraciones específicas para el entorno de producción:
   * - EnableCompression: Si se habilita la compresión
   * - EnableCaching: Si se habilita el caché
   * - EnableLogging: Si se habilita el logging
   */
  "ProductionSettings": {
    "EnableCompression": true,
    "EnableCaching": true,
    "EnableLogging": true,
    "EnableMetrics": true
  },

  /**
   * Configuración de Kestrel (servidor web)
   * 
   * Define configuraciones del servidor web Kestrel:
   * - Endpoints: Configuración de endpoints HTTP/HTTPS
   * - Limits: Límites de conexiones y tiempo de espera
   */
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:5001"
      }
    },
    "Limits": {
      "MaxConcurrentConnections": 100,
      "MaxConcurrentUpgradedConnections": 100,
      "MaxRequestBodySize": 52428800,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30"
    }
  },

  /**
   * Configuración de Entity Framework
   * 
   * Define configuraciones específicas para Entity Framework:
   * - EnableSensitiveDataLogging: Si se habilita el logging de datos sensibles
   * - EnableDetailedErrors: Si se muestran errores detallados
   * - CommandTimeout: Timeout para comandos de base de datos
   */
  "EntityFramework": {
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false,
    "CommandTimeout": 30,
    "RetryCount": 3,
    "RetryDelay": "00:00:01"
  },

  "AllowedHosts": "*"
}
