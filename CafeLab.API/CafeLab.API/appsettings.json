// Configuración para MySQL. Asegúrate de que la base de datos y usuario existen.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=cafelab_db;User=root;Password=;"
  },
  "JwtSettings": {
    "SecretKey": "CafeLab_Super_Secure_Secret_Key_For_JWT_Tokens_2024_Minimum_32_Characters_Long",
    "Issuer": "CafeLab.API",
    "Audience": "CafeLab.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "AllowedHosts": "*"
}
